# Containerfile — ACV Documentation static site (nginx:alpine)
# Build:
#   podman build -t acv-docs:latest -f deploy/Containerfile .
# Run (mount certs from host, expose 443):
#   podman run -d --name acv-docs \
#     -p 443:8443 \
#     -v /etc/pki/acv-docs:/certs:ro,Z \
#     --restart=always \
#     acv-docs:latest
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine

USER 0
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx-acv-docs.container.conf /etc/nginx/conf.d/acv-docs.conf

# Copy site (build artefacts only — see .containerignore)
WORKDIR /usr/share/nginx/html
COPY . /usr/share/nginx/html/

RUN chown -R 101:101 /usr/share/nginx/html
USER 101

EXPOSE 8443
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget -qO- --no-check-certificate https://127.0.0.1:8443/ >/dev/null || exit 1
